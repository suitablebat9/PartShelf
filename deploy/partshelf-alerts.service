[Unit]
Description=Partshelf low-stock email notifications
After=network-online.target partshelf.service

[Service]
Type=oneshot
User=partshelf
Group=partshelf
WorkingDirectory=/opt/partshelf/current
Environment=INVENTORY_DATA=/var/lib/partshelf
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=-/etc/partshelf.env
ExecStart=/opt/partshelf/current/.venv/bin/flask --app wsgi send-stock-alerts
TimeoutStartSec=240
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/partshelf
